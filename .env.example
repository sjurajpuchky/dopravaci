DATABASE_URL="mysql://dopravaci:dopravaci@127.0.0.1:3306/dopravaci"
APP_URL="http://localhost:3000"
GOOGLE_TAG_ID="G-FN28LJKTQT"
GOOGLE_SITE_VERIFICATION=""
SEZNAM_SITE_VERIFICATION=""

# Google reCAPTCHA v3 pro kalkulačku a kontaktní formulář.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.7"
# Volitelně čárkou oddělené hostname vrácené Googlem, např. dopravaci.cz,www.dopravaci.cz
RECAPTCHA_ALLOWED_HOSTNAMES=""
SESSION_COOKIE_SECURE="false"
EMAIL_VERIFICATION_REQUIRED="false"

# Volitelné SMTP pro ověřovací a resetovací e-maily.
# SMTP_HOST musí odpovídat názvu v TLS certifikátu poštovního serveru.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_AUTH="true"
SMTP_IGNORE_TLS="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Dopravaci.cz <noreply@example.cz>"

# Volitelný první administrátor pro `npm run db:seed`.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Pro produkci nastavte trvalý adresář připojený k aplikaci.
UPLOAD_DIR="public/uploads"
